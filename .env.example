# =============================================================================
# Friese — variables de entorno del BACKEND (Django)
# =============================================================================
# Copiar este archivo como `.env` en la raíz del repo y completar los valores.
# El `.env` NO se commitea (está en .gitignore); este `.env.example` sí, y es la
# lista de referencia de todo lo que el proyecto lee del entorno.
#
# En producción (Railway/Render) NO se sube ningún archivo: estas mismas
# variables se cargan en el panel de la plataforma.
#
# Los valores de acá son PLACEHOLDERS de ejemplo, no credenciales reales.
# =============================================================================


# --- Ambiente ----------------------------------------------------------------
# 'development' (default si no se define) o 'production'. Es lo único que hay que
# cambiar para pasar de un ambiente al otro: define qué defaults se aplican y qué
# variables pasan a ser obligatorias. Si falta alguna obligatoria, el proyecto NO
# arranca y el error las lista todas juntas.
DJANGO_ENV=development

# Solo tiene efecto en desarrollo (default: True). En producción DEBUG queda
# apagado siempre, sin importar lo que diga esta variable.
DEBUG=True

# Obligatoria en producción. Generar una nueva y no reutilizar la de desarrollo:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Hosts que el backend acepta servir, separados por coma, sin esquema ni barra.
# Desarrollo (default): localhost,127.0.0.1
# Producción: OBLIGATORIA — el/los dominios reales del backend.
ALLOWED_HOSTS=localhost,127.0.0.1


# --- Base de datos (Supabase / PostgreSQL) -----------------------------------
# Obligatoria en TODOS los ambientes. Cadena del pooler de Supabase.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:6543/postgres


# --- Frontend ----------------------------------------------------------------
# Origen del frontend del RECEPTOR: es la base del link único que se le manda por
# email al despachar ({FRONTEND_PUBLIC_URL}/remito/{public_token}). Hoy es la
# misma app de Vite que la del operador (ruta pública /remito/{token}).
# Desarrollo (default): http://localhost:5173
# Producción: OBLIGATORIA — con el default, todos los emails saldrían con un
# link a localhost.
FRONTEND_PUBLIC_URL=http://localhost:5173

# Orígenes autorizados a consumir la API desde el navegador (CORS), separados por
# coma, con esquema y sin barra final.
# Desarrollo (default): http://localhost:3000,http://localhost:5173
# Producción: OBLIGATORIA — los dominios de los frontends desplegados.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# --- Cloudflare R2 (fotos de evidencia) --------------------------------------
# Obligatorias en producción: sin ellas la subida de evidencia responde 502.
R2_ACCOUNT_ID=id-de-la-cuenta-de-cloudflare
R2_ACCESS_KEY=access-key-del-token-de-r2
R2_SECRET_KEY=secret-key-del-token-de-r2
R2_BUCKET_NAME=friese-evidence

# Opcional. Endpoint S3 de la cuenta; por default se arma solo a partir de
# R2_ACCOUNT_ID (https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com).
# R2_ENDPOINT_URL=

# Base pública de Evidence.file_url. En desarrollo alcanza con el dev URL del
# bucket (https://pub-XXXX.r2.dev). En producción es OBLIGATORIA y debería ser un
# dominio propio conectado al bucket (Custom Domains): el dev URL de r2.dev tiene
# rate limit y Cloudflare lo marca como no apto para producción.
# OJO: cambiarla no reescribe las evidencias ya guardadas, que quedan con el
# prefijo viejo (ver pendientes de la tarea 2.4 en PROGRESS.md).
R2_PUBLIC_BASE_URL=https://pub-XXXXXXXX.r2.dev


# --- Resend (emails transaccionales) -----------------------------------------
# Obligatoria en producción: sin ella no sale ningún email del sistema (el
# despacho, la queja y el cierre igual se completan, pero el aviso queda en el log).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Casilla remitente. Resend solo envía desde un dominio VERIFICADO en la cuenta.
# Desarrollo (default): onboarding@resend.dev, que además SOLO puede escribirle al
# dueño de la cuenta de Resend.
# Producción: OBLIGATORIA — una casilla del dominio propio (ej. remitos@friese.app).
RESEND_FROM_EMAIL=onboarding@resend.dev


# --- Seguridad ---------------------------------------------------------------
# Todas OPCIONALES: tienen default y solo hace falta tocarlas para ajustar.
# En producción, además y sin variable de por medio, se activan solos: redirect a
# HTTPS, HSTS, cookies Secure y CSRF_TRUSTED_ORIGINS derivado de ALLOWED_HOSTS.

# Cupo de requests por IP en los endpoints públicos del receptor (/api/public/).
# Se aplican los dos a la vez: se pasa cualquiera → 429. Formato de DRF:
# "N/second" | "N/min" | "N/hour" | "N/day". Defaults: 30/min y 300/hour.
# PUBLIC_THROTTLE_BURST=30/min
# PUBLIC_THROTTLE_SUSTAINED=300/hour

# Cuántos proxies hay delante del backend, para saber de qué IP se cuenta el cupo.
# Solo se lee en producción (en desarrollo se usa siempre REMOTE_ADDR). Default 1,
# que es el caso de Railway/Render. Subirlo solo si se agrega otro proxy adelante
# (ej. Cloudflare por delante de la plataforma → 2).
# NUM_PROXIES=1

# Segundos de vigencia del header HSTS en producción. Default 31536000 (1 año).
# Conviene arrancar chico (ej. 3600) los primeros días: mientras el header esté
# vigente el browser NO deja entrar por http a ese dominio aunque se apague acá.
# SECURE_HSTS_SECONDS=31536000

# Orígenes (con esquema) en los que Django confía para POSTear formularios, o sea
# el login del Django Admin. Si no se define, en producción se deriva de
# ALLOWED_HOSTS con https://. Definirla solo si el admin se sirve en un dominio
# que no está en ALLOWED_HOSTS.
# CSRF_TRUSTED_ORIGINS=https://api.friese.app


# --- Notificaciones ----------------------------------------------------------
# Horas desde el despacho, sin que el receptor abra el link, antes de mandarle el
# recordatorio (comando send_pending_reminders). Opcional, default 24.
REMINDER_AFTER_HOURS=24


# =============================================================================
# FRONTEND (Vite) — estas NO van acá: van en `frontend/.env`.
# Ver `frontend/.env.example`.
# =============================================================================
